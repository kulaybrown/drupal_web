# Copy of the values docker-compose.yml reads. Change the passwords before
# using this anywhere beyond your own machine.

# --- Database ---
DB_NAME=drupal_web
DB_USER=drupal_web_user
DB_PASSWORD=drupal_web_pass
DB_ROOT_PASSWORD=rootpass_change_me

# --- Ports on your host machine ---
HTTP_PORT=8080
ADMINER_PORT=8081
